NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/securechain_test
DATABASE_SSL=false
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h

# Use local for development, or supabase for encrypted cloud file storage.
STORAGE_PROVIDER=local
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_STORAGE_BUCKET=mediv-private-files
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Base64-encoded 32-byte key. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FILE_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Backend registry signer must be the deployed contract owner.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
BLOCKCHAIN_PRIVATE_KEY=replace-with-dedicated-backend-signer-private-key
