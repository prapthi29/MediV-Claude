# Configure these only to deploy to a persistent Ethereum-compatible testnet.
BLOCKCHAIN_RPC_URL=https://your-testnet-rpc.example
# Hex private key for a dedicated, low-balance deployer wallet. Do not use a personal wallet.
BLOCKCHAIN_DEPLOYER_PRIVATE_KEY=0xyour_private_key

# Sepolia (npm run deploy:sepolia). DEPLOYER_PRIVATE_KEY may omit the 0x prefix.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-key
DEPLOYER_PRIVATE_KEY=0xyour_private_key
# Optional, for npm run verify:sepolia
ETHERSCAN_API_KEY=your-etherscan-api-key
